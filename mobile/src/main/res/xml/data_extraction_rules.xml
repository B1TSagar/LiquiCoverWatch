<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="covers_v3/" />
        <exclude domain="file" path="lyrics/" />
        <exclude domain="file" path="albums/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="covers_v3/" />
        <exclude domain="file" path="lyrics/" />
        <exclude domain="file" path="albums/" />
    </device-transfer>
</data-extraction-rules>
